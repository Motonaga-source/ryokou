# Neon PostgreSQL (本番用)
# Neon ダッシュボード → 対象DBの "Connection Details" → "Pooled connection" をコピー
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon ダッシュボード → "Direct connection" をコピー（マイグレーション用）
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 認証用シークレットキー（任意の長い文字列）
JWT_SECRET="your-secret-key-here-change-this-in-production"
