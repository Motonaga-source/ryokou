// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== 旅行イベント =====
model Trip {
  id          Int      @id @default(autoincrement())
  name        String
  destination String
  startDate   DateTime
  endDate     DateTime
  notes       String?
  travelFee   Int?
  pocketMoney Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participations     TripParticipation[]
  rooms              Room[]
  schedules          Schedule[]
  supplyItems        SupplyItem[]
  teams              Team[]
  cars               Car[]
  banquetSeats       BanquetSeatAssignment[]
  lunchSeats         LunchSeatAssignment[]
  lunchTables        LunchTable[]
  busSeats           BusSeatAssignment[]
  pocketMoneyRecords PocketMoneyRecord[]
  bathingAssignments BathingAssignment[]
  pickupAssignments  PickupAssignment[]
}

// ===== 人物（スタッフ・利用者共通） =====
model Person {
  id        Int      @id @default(autoincrement())
  name      String
  nameKana  String?
  gender    String?
  role      String   // "STAFF" | "USER"
  isAdmin      Boolean  @default(false)
  isWheelchair Boolean  @default(false)
  wheelchairSource   String?  // 車椅子の出所: "グレイス貸出" | "持参"
  wheelchairPrepared Boolean  @default(false) // 未使用（旧: 持ち物チェックの準備済み）
  isFishNG     Boolean  @default(false) // 魚料理NG
  pickupMemo   String?  // 集合・送迎の特記事項
  isRollCalled Boolean  @default(false) // 簡易点呼のチェック状態（履歴なし。点呼のたびに一括クリアして使い回す）
  allowanceManagementType     String?  // 小遣いの管理区分: "STAFF"（スタッフ管理）| "USER"（本人管理）| "SELF"（自己管理・法人準備なし）
  allowanceRequiresCollection Boolean  @default(false) // 小遣いの事後回収（お釣り・レシート等）が必要か
  password  String?
  facility  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medication         Medication?
  participations     TripParticipation[]
  roomAssignments    RoomAssignment[]
  busAssignments     BusSeatAssignment[]
  carAssignments     CarAssignment[]
  teamMemberships    TeamMember[]
  vitalRecords       VitalRecord[]
  bathingAssignments BathingAssignment[]
  banquetSeats       BanquetSeatAssignment[]
  lunchSeats         LunchSeatAssignment[]
  pocketMoneyRecord  PocketMoneyRecord?
  carryItems         SupplyCarryAssignment[]
  pickupAssignments  PickupAssignment[]
}

// ===== 服薬情報（利用人のみ） =====
model Medication {
  id             Int      @id @default(autoincrement())
  personId       Int      @unique
  hasBreakfast   Boolean  @default(false)
  breakfastNote  String?
  hasLunch       Boolean  @default(false)
  lunchNote      String?
  hasDinner      Boolean  @default(false)
  dinnerNote     String?
  hasSleep       Boolean  @default(false)
  sleepNote      String?
  hasAsNeeded    Boolean  @default(false)
  asNeededNote   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

// ===== 旅行参加状況 =====
model TripParticipation {
  id           Int     @id @default(autoincrement())
  tripId       Int
  personId     Int
  status       String  // "参加" | "不参加" | "保留"
  feeMethod    String?
  feeCollected Boolean @default(false)
  notes        String?
  gatherPlace  String?

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tripId, personId])
}

// ===== 客室 =====
model Room {
  id         Int    @id @default(autoincrement())
  tripId     Int
  roomNumber String
  floor      Int
  roomType   String
  capacity   Int
  notes      String?

  trip         Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  assignments  RoomAssignment[]
  vitalRecords VitalRecord[]

  @@unique([tripId, roomNumber])
}

// ===== 部屋割り =====
model RoomAssignment {
  id       Int     @id @default(autoincrement())
  roomId   Int
  personId Int
  isStaff  Boolean @default(false)
  notes    String?

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([roomId, personId])
}

// ===== バイタルチェック =====
model VitalRecord {
  id                Int      @id @default(autoincrement())
  personId          Int
  roomId            Int?
  bloodPressureHigh Int?
  bloodPressureLow  Int?
  pulse             Int?
  temperature       Float?
  notes             String?
  recordedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  room   Room?  @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

// ===== チーム =====
model Team {
  id     Int     @id @default(autoincrement())
  tripId Int
  name   String
  color  String?

  trip    Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  members TeamMember[]
}

model TeamMember {
  id       Int     @id @default(autoincrement())
  teamId   Int
  personId Int
  isLeader Boolean @default(false)

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([teamId, personId])
}

// ===== 入浴担当 =====
enum BathingRole {
  MAIN_BATH_MALE          // 大浴場（男湯）
  MAIN_BATH_FEMALE        // 大浴場（女湯）
  DRESSING_SUPPORT_MALE   // 脱衣所サポート（男湯）
  DRESSING_SUPPORT_FEMALE // 脱衣所サポート（女湯）
  ESCORT_MALE             // 送迎・誘導（男湯）
  ESCORT_FEMALE           // 送迎・誘導（女湯）
  ROOM_BATH               // 部屋風呂
  INDEPENDENT             // 自立入浴
}

model BathingAssignment {
  id        Int          @id @default(autoincrement())
  tripId    Int
  personId  Int
  role      BathingRole?
  banNumber Int?         // 入浴の班（1〜3班、未設定は null）
  category  String?      // 旧区分（例: "介助_女"）。互換のため保持
  notes     String?

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tripId, personId])
}

// ===== サイドバーのメニュー並び順 =====
// path は一般画面のパス（例: "/persons"）。管理画面のメニュー（/admin/persons）も同じ順番で表示する
model MenuOrder {
  path      String @id
  sortOrder Int
}

// ===== 集合・送迎 =====
// 送迎車。名称・定員・所属拠点は管理画面から追加・変更・削除できる
model PickupVehicle {
  id       Int    @id @default(autoincrement())
  name     String
  capacity Int
  location String // 所属: "yuzato" | "grace" | "uriwari-nishi" | "other"（lib/pickup.ts を参照）
}

model PickupAssignment {
  id       Int    @id @default(autoincrement())
  tripId   Int
  personId Int
  groupId  String // "walk-{拠点}" | "family" | "car-{送迎車id}"（lib/pickup.ts を参照）

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tripId, personId])
}

// ===== 宴会場席次 =====
model BanquetSeatAssignment {
  id       Int     @id @default(autoincrement())
  tripId   Int
  personId Int
  seatId   String  // 54席の座席ID（例: "seat-L-1"）。lib/banquet.ts の BANQUET_SEAT_IDS を参照
  notes    String?

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tripId, personId])
  @@unique([tripId, seatId])
}

// ===== 昼食会場の席次（2日目 伊賀の里もくもく手づくりファーム） =====
// テーブルごとに定員と車椅子枠（車椅子のまま座る位置の数。定員に含む）を持つ。初期データは lib/lunch.ts
model LunchTable {
  id              Int @id @default(autoincrement())
  tripId          Int
  tableNo         Int
  capacity        Int
  wheelchairSlots Int @default(0)
  layoutRow       Int @default(0) // 配置図の行（0: 奥の列、1: 手前の列）
  layoutOrder     Int @default(0) // 行内の左からの並び順

  trip        Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  assignments LunchSeatAssignment[]

  @@unique([tripId, tableNo])
}

// 座席単位の割り当て。seatIndex はテーブル内の席番号（0 から。先頭の wheelchairSlots 個が車椅子枠）
model LunchSeatAssignment {
  id        Int     @id @default(autoincrement())
  tripId    Int
  personId  Int
  tableId   Int
  seatIndex Int
  notes     String?

  trip   Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  person Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  table  LunchTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tripId, personId])
  @@unique([tableId, seatIndex]) // 同じ席に2人座らない
}

// ===== バス座席 =====
model BusSeatAssignment {
  id       Int     @id @default(autoincrement())
  tripId   Int
  personId Int
  rowNo    Int?
  seatSide String?
  seatType String?
  vehicle  String?
  notes    String?

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([tripId, personId])
}

// ===== 小遣い精算 =====
model PocketMoneyRecord {
  id        Int @id @default(autoincrement())
  tripId    Int
  personId  Int @unique
  allocated Int
  used      Int @default(0)
  remaining Int @default(0)

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

// ===== スケジュール =====
model Schedule {
  id          Int    @id @default(autoincrement())
  tripId      Int
  timeLabel   String
  location    String
  description String?
  assignedTo  String?
  dayNo       Int    @default(1)
  sortOrder   Int    @default(0)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

// ===== 持ち物 =====
model SupplyItem {
  id        Int      @id @default(autoincrement())
  tripId    Int
  itemName  String
  quantity  String?
  facility  String?
  category  String?  // "共通備品" | "施設別の薬"
  notes     String?
  isChecked Boolean  @default(false) // 未使用（旧: 持ち物チェック）

  trip         Trip                    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  carryPersons SupplyCarryAssignment[]
}

model SupplyCarryAssignment {
  id           Int @id @default(autoincrement())
  supplyItemId Int
  personId     Int

  supplyItem SupplyItem @relation(fields: [supplyItemId], references: [id], onDelete: Cascade)
  person     Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([supplyItemId, personId])
}
// ===== ��p�� =====
model Car {
  id        Int      @id @default(autoincrement())
  tripId    Int
  name      String
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  assignments CarAssignment[]
}

model CarAssignment {
  id        Int      @id @default(autoincrement())
  carId     Int
  personId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  car    Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([carId, personId])
}
